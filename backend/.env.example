# Environment Variables — Selam Consulting Backend
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.

# ─── MongoDB ─────────────────────────────────────────────────────────────────
# Replace with your actual MongoDB connection string (Atlas or self-hosted)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/selam_consulting?retryWrites=true&w=majority

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=5000

# ─── Security & Auth ─────────────────────────────────────────────────────────
JWT_SECRET=selam_consulting_super_secret_jwt_key_2026

# ─── Default Admin Credentials ───────────────────────────────────────────────
# Created automatically on first run if no admin account exists in DB
ADMIN_EMAIL=admin@selam.com
ADMIN_PASSWORD=admin123

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins (no trailing slash)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:5500,http://localhost:5500
